# Production builds are reached through the Home-Dashboard hub, which exposes
# the app under /Spotify-Wrapped/ and forwards /Spotify-Wrapped/api/* to the
# backend's /api/* (prefix stripped). So API calls are same-origin, relative
# and prefixed with the app path. Dev keeps http://127.0.0.1:3000 in .env.
VITE_API_BASE_URL="/Spotify-Wrapped"
