# SQLite database file (relative to backend/)
DATABASE_URL="file:./dev.db"

# Spotify app credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="YOUR_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# Used by the one-time connect script (must match the app's redirect URI)
SPOTIFY_REDIRECT_URI="http://localhost:3000/callback"

# CORS origin for the frontend ("*" for local dev)
CORS_ORIGIN="*"

PORT=3000

# Bind address. Default 0.0.0.0 (LAN-wide). Behind the Home-Dashboard hub set
# HOST=127.0.0.1 so port 3000 is only reachable from the Pi itself; the app is
# then reached through the hub at /Spotify-Wrapped/.
HOST=0.0.0.0

# How often the poller asks Spotify what's playing
POLL_INTERVAL_SECONDS=15
