// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String           @id @default(uuid())
  spotifyUserId  String?          @unique
  email          String?          @unique
  displayName    String?
  createdAt      DateTime         @default(now())
  spotifyAccount SpotifyAccount?
  plays          Play[]
}

model SpotifyAccount {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @unique

  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime

  // Cursor so we don't scan Play table every time
  lastAfterMs    BigInt?  // unix ms timestamp used in "after="

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Play {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String

  spotifyUri   String   // stable identifier (works even if id missing)
  spotifyId    String?  // track id if provided

  trackName    String
  artistName   String
  albumName    String?
  playedAt     DateTime
  // Milliseconds actually listened. Import rows carry ms_played from the export;
  // api rows start at the progress seen by the first poll and grow with every poll.
  durationMs   Int
  // Full length of the track (api rows only; null for imported rows).
  trackDurationMs Int?

  // Playback context from the currently-playing endpoint (null when Spotify
  // sends no context, e.g. autoplay/radio). playlistName is resolved via
  // GET /playlists/{id} and stays null for non-playlist contexts or when the
  // playlist is not readable (private without scope, Spotify-owned algorithmic).
  contextType  String?  // "playlist" | "album" | "artist" | "show"
  contextUri   String?  // e.g. "spotify:playlist:3cEYpjA9oz9GiPac4AsH4n"
  playlistName String?

  source       String   @default("api")
  createdAt    DateTime @default(now())

  @@index([userId, playedAt])
  @@index([playedAt]) // date-window filters query playedAt without userId
  @@index([contextUri]) // playlist grouping + ?playlist= filters
  @@unique([userId, playedAt, spotifyUri]) // prevents duplicates cleanly
}

// ---------------------------------------------------------------------------
// Catalog: Spotify track/artist metadata fetched once by `npm run enrich:catalog`
// (and kept current by the server for new plays). Plays never change; joins go
// Play.spotifyId -> Track.spotifyId -> Artist(primaryArtistId).
// ---------------------------------------------------------------------------

model Track {
  spotifyId       String   @id // Play.spotifyId joins here
  name            String
  primaryArtistId String? // artists[0].id — the one the genre comes from
  artistIds       String // JSON array of artist ids in Spotify's order
  albumName       String?
  releaseDate     String? // as Spotify gives it: YYYY, YYYY-MM or YYYY-MM-DD
  durationMs      Int?
  imageUrl        String? // album image, the 300px one if present
  fetchedAt       DateTime @default(now())

  @@index([primaryArtistId])
}

model Artist {
  spotifyId  String   @id
  name       String
  genres     String // JSON array of strings as returned (may be [])
  group      String? // readable group from the rule table, null = unmapped
  imageUrl   String?
  popularity Int?
  fetchedAt  DateTime @default(now())

  @@index([group])
}
